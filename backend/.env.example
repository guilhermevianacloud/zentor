PORT=3333
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
# DB_FILE=./data/zentor.db

# ---------- Mercado Pago (Checkout Pro) ----------
# Sem MP_ACCESS_TOKEN, o pagamento continua SIMULADO.
# Pegue em https://www.mercadopago.com.br/developers/panel/app → sua aplicação → Credenciais de teste.
# NUNCA coloque o token no app, no Git, no README ou em print: ele fica só neste arquivo .env.
# MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Opcional: endereço público https da API (ex.: túnel do ngrok). Com ele, o Mercado Pago
# volta sozinho para a loja depois do pagamento aprovado.
# MP_URL_PUBLICA=https://seu-endereco.ngrok-free.app
# Opcional: aviso automático (webhook). Precisa de endereço público https.
# MP_WEBHOOK_URL=https://seu-endereco.ngrok-free.app/api/webhooks/mercadopago
# MP_WEBHOOK_SECRET=assinatura-secreta-do-painel-de-webhooks
